# Copiado para /opt/backdraft/.env (chmod 640, dono root:backdraft) pelo deploy/instalar.sh, que gera os segredos.
# Nunca coloque este arquivo preenchido no git.

# ---------------------------------------------------------------- servidor
# Escuta em HTTPS na rede interna (certificado autoassinado gerado pelo instalador).
BACKDRAFT_BIND=0.0.0.0
BACKDRAFT_PORT=8443
# Subcaminho se for publicado atras de um proxy reverso (vazio = raiz). Ex.: /backdraft
BACKDRAFT_BASE=
BACKDRAFT_SECRET=gerado-pelo-instalador
COOKIE_SECURE=1
# Pasta gravavel: historico diario, listas KEV/EPSS baixadas e estado dos avisos
BACKDRAFT_ESTADO=/var/lib/backdraft
TLS_CERT=/opt/backdraft/tls/cert.pem
TLS_KEY=/opt/backdraft/tls/key.pem
# Sessao normal: inatividade e vida maxima (segundos)
IDLE_SECONDS=900
MAX_LIFE_SECONDS=28800
# Proxies de confianca (para ler o IP real em X-Real-IP). Vazio = acesso direto.
TRUSTED_PROXIES=
# Restricao por IP (opcional; IPs ou redes separados por virgula). Vazio = qualquer IP que alcance a porta.
# Ex.: ALLOWED_IPS=192.0.2.10,198.51.100.0/24
ALLOWED_IPS=
# Nome da organizacao (aparece no titulo e no cabecalho do relatorio). Vazio = so "Backdraft".
ORG_NOME=
# Fuso horario das datas, do historico diario e do resumo semanal (nome IANA)
BACKDRAFT_TZ=America/Sao_Paulo
# Quantas maquinas DEVERIAM ter agente do Wazuh (ex.: computadores ativos do seu AD). O relatorio mostra "monitoradas X de Y".
# 0 = nao informar (o relatorio so diz quantas estao monitoradas e quantas com agente desconectado).
MAQUINAS_ESPERADAS=0

# ---------------------------------------------------------------- indexador do Wazuh
# Usuario SOMENTE LEITURA em wazuh-states-vulnerabilities-* (e, opcionalmente, wazuh-monitoring-*). Veja o README.
# A cadeia do certificado e validada com a CA do Wazuh; o NOME do certificado nao e conferido (o certificado padrao do
# indexador so tem 127.0.0.1 no SAN).
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=backdraft-read
INDEXER_PASS=
INDEXER_CA=/opt/backdraft/root-ca.pem
# Os dados do Wazuh so mudam a cada ~1 h: resultados pesados ficam em cache (segundos)
CACHE_SECONDS=300

# ---------------------------------------------------------------- quem pode entrar
# Logins autorizados, separados por virgula. Sem isso ninguem entra (vale para LDAP e para usuarios locais).
ALLOWED_USERS=

# ---------------------------------------------------------------- autenticacao A: usuarios locais (sem LDAP)
# usuario|hash, separados por virgula. Gere cada entrada com:   python3 /opt/backdraft/backdraft.py --gerar-hash usuario
LOCAL_USERS=

# ---------------------------------------------------------------- autenticacao B: LDAPS (opcional, pode combinar com A)
# Um servidor so:
LDAP_HOST=
LDAP_PORT=636
LDAP_BASE=
# Como montar o DN do usuario no bind direto ({usuario} ja vem escapado; {base} = LDAP_BASE)
LDAP_USER_DN=uid={usuario},{base}
# Certificado do servidor LDAP (PEM) fixado; so conecta se bater
LDAP_CA=/opt/backdraft/ldap-ca.pem
# Nome DNS que consta no certificado (o ldap3 no Python 3.12 nao valida IP no SAN, so DNS). Vazio = nao confere o nome.
LDAP_NAME=
#
# OU dois servidores (redundancia por rede): o painel tenta primeiro o que atende a rede de quem esta entrando e, se ele nao
# responder, tenta o outro. Senha errada e definitiva (nao tenta o outro). Quando BROKER_*_HOST esta preenchido, o LDAP_HOST
# acima e ignorado (LDAP_BASE, LDAP_USER_DN valem para os dois).
BROKER_A_NOME=
BROKER_A_HOST=
BROKER_A_PORT=636
BROKER_A_CA=/opt/backdraft/ldap-ca-a.pem
BROKER_A_NAME=
BROKER_A_REDES=
BROKER_B_NOME=
BROKER_B_HOST=
BROKER_B_PORT=636
BROKER_B_CA=/opt/backdraft/ldap-ca-b.pem
BROKER_B_NAME=
BROKER_B_REDES=

# "Lembrar de mim" na tela de login: sessao em cookie persistente por REMEMBER_DAYS dias, com REMEMBER_IDLE_SECONDS de
# inatividade tolerada (renovada a cada acao do usuario). REMEMBER_DAYS=0 remove a opcao da tela.
REMEMBER_DAYS=7
REMEMBER_IDLE_SECONDS=86400

# ---------------------------------------------------------------- avisos (desligados enquanto vazios)
# O Wazuh nao alerta CVE nova: o Backdraft avisa quando surgirem criticas novas (no maximo 1 aviso a cada
# AVISO_INTERVALO_HORAS) e manda um resumo toda segunda-feira as 8h (fuso BACKDRAFT_TZ).
# Telegram: crie um bot no @BotFather, coloque o token aqui e o id do chat/grupo em TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail (SMTP_MODE: starttls, ssl ou plain). SMTP_TO aceita varios enderecos separados por virgula.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
AVISO_MIN_NOVAS=1
AVISO_INTERVALO_HORAS=6
# Endereco do painel que vai no final do aviso
AVISO_URL=https://backdraft.example.com/
